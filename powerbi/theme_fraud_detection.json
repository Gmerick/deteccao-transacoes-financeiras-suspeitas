{
  "name": "Fraud Detection Portfolio",
  "dataColors": ["#2563EB", "#0891B2", "#F59E0B", "#DC2626", "#16A34A", "#7C3AED"],
  "background": "#F8FAFC",
  "foreground": "#0F172A",
  "tableAccent": "#2563EB",
  "visualStyles": {
    "*": {
      "*": {
        "title": [{"show": true, "fontFamily": "Segoe UI Semibold", "fontSize": 12, "fontColor": {"solid": {"color": "#0F172A"}}}],
