        "border": [{"show": true, "color": {"solid": {"color": "#CBD5E1"}}, "radius": 6}]
      }
    }
  },
  "textClasses": {
    "title": {"fontFace": "Segoe UI Semibold", "color": "#0F172A"},
    "label": {"fontFace": "Segoe UI", "color": "#334155"},
    "callout": {"fontFace": "Segoe UI Semibold", "color": "#0F172A"}
  }
}

